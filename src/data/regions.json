        "requires": "|Vault of Glass Key| AND |Cleared Raid:3| AND (|Legend of Acrius| AND |Titan Unlock| AND |Roaring Flames| AND |Synthoceps| AND |Solar Unlock|)",
        "starting": true
    },
    "Deep Stone Crypt": {
        "requires": "|Deep Stone Crypt Key| AND ((|Parasite| AND |Titan Unlock| AND (|Arc Unlock| OR |Prismatic Unlock|) AND |Cuirass of the Falling Star| AND |Crossbow / High-Impact|) OR (|Warlock Unlock| AND |Solar Unlock| AND |Sunbracers| AND |Touch of Flame| AND |Ember of Ashes|))"
    },
    "Garden of Salvation": {
        "requires": "|Garden of Salvation Key| AND ((|Leviathan's Breath| OR |@Weapons - Linear Fusion Rifle|) AND |@Roam Weapons| AND (|Warlock Unlock| OR |Titan Unlock|))"
    },
