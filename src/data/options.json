{
    "$schema": "https://raw.githubusercontent.com/ManualForArchipelago/Manual/main/schemas/Manual.options.schema.json",
    "_comment": "Add a _ before an option name to comment it out and it wont be added to the apworld",
    "core": {
        "death_link": {
            "default": false
        },
        "filler_traps": {
            "_comment": "Using values here let you set a 'recommended' filler_trap percentage or even a default percentage",
            "values": {
                "recommended": 20
            }
        }
    },
    "user": {
        "_commented_out_option":{
            "type": "Toggle",
            "default": true
        },
        "enable_rank_b":{
            "description": [
                "Marks Rank B Weapons as valid for logic as part of a \"Good Loadout\"",
                "Weapon rankings are based on this spreadsheet_ with a few modifications",
                ".. _spreadsheet: https://docs.google.com/spreadsheets/d/1JM-0SlxVDAi-C6rGVlLxa-J1WGewEeL8Qvq4htWZHhY/edit?gid=1301036036#gid=1301036036"
            ],
            "rich_text_doc": true,
            "type": "Toggle",
            "default": true,
            "group": "Weapon Ranks"
        },
        "enable_rank_c":{
            "description": [
                "Marks Rank C Weapons as valid for logic as part of a \"Good Loadout\"",
                "Weapon rankings are based on this spreadsheet_ with a few modifications",
                ".. _spreadsheet: https://docs.google.com/spreadsheets/d/1JM-0SlxVDAi-C6rGVlLxa-J1WGewEeL8Qvq4htWZHhY/edit?gid=1301036036#gid=1301036036"
            ],
            "rich_text_doc": true,
            "type": "Toggle",
            "default": false,
            "group": "Weapon Ranks"
        },
        "enable_rank_d":{
            "description": [
                "Marks Rank D Weapons as valid for logic as part of a \"Good Loadout\"",
                "Weapon rankings are based on this spreadsheet_ with a few modifications",
                ".. _spreadsheet: https://docs.google.com/spreadsheets/d/1JM-0SlxVDAi-C6rGVlLxa-J1WGewEeL8Qvq4htWZHhY/edit?gid=1301036036#gid=1301036036"
            ],
            "rich_text_doc": true,
            "type": "Toggle",
            "default": false,
            "group": "Weapon Ranks"
        },
        "starting_class":{
            "type": "Choice",
            "description": [
                "What class will you be running ?",
                "Used to limit available exotics",
                "Multi-class and class unlocks coming later"
            ],
            "values": {
                "Titan":0,
                "Warlock":1,
                "Hunter":2
             },
            "default": 0,
            "allow_custom_value": false,
            "group": "Game Options"
        },
        "clears_required_for_victory":{
            "type": "Range",
            "description": [
                "The win condition of this manual is to beat X number of different dungeons. Use this option to define the number of dungeons required for victory."
            ],
            "range_start": 1,
            "default": 3,
            "range_end": 11,
            "group": "Game Options"
        },

        "_DLC_enabled":{
            "display_name": "DLC Enabled",
            "description": "Is the Dlc enabled?",
            "type": "Toggle",
            "visibility": [
                "simple_ui",
                "complex_ui",
                "template"
            ],
            "default": true
        }
    }

}
